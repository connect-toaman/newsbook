generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CONTRIBUTOR")
  createdAt DateTime @default(now())
}

model Post {
  id          String   @id @default(uuid())
  title       String
  content     String
  imageUrl    String?
  category    String?
  district    String?
  author      String   @default("Citizen Journalist / Admin")
  likesCount  Int      @default(0)
  sharesCount Int      @default(0)
  createdAt   DateTime @default(now())
}
